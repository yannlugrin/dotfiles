#!/bin/bash
#
# System-wide setup: everything that needs sudo. Runs before rcup creates the
# symlinks. Per-user toolchains live in post-up instead.

set -u

if [ -n "${WSL_DISTRO_NAME:-}" ] || grep -qi microsoft /proc/version 2>/dev/null; then
  IS_WSL=1
else
  IS_WSL=0
fi

# Setup GitHub's own apt repository.
if command -v apt-get >/dev/null 2>&1 && command -v curl >/dev/null 2>&1; then
  gh_keyring=/etc/apt/keyrings/githubcli-archive-keyring.gpg
  gh_tmp=$(mktemp)

  if curl -fsSL -o "$gh_tmp" https://cli.github.com/packages/githubcli-archive-keyring.gpg; then
    sudo install -d -m 755 /etc/apt/keyrings
    sudo install -m 644 "$gh_tmp" "$gh_keyring"

    sudo tee /etc/apt/sources.list.d/github-cli.sources >/dev/null <<EOF
Types: deb
URIs: https://cli.github.com/packages
Suites: stable
Components: main
Architectures: $(dpkg --print-architecture)
Signed-By: $gh_keyring
EOF
  else
    echo "Could not fetch the GitHub CLI signing key; skipping its apt repository." >&2
  fi

  rm -f "$gh_tmp"
fi

# Install dependencies on Ubuntu
if command -v apt-get >/dev/null 2>&1; then
  sudo apt-get update
  sudo apt-get upgrade -y

  packages=(
    autoconf     # ruby-build only Suggests it, so ask for it explicitly
    composer
    curl
    gh
    git
    jq
    locales
    php-cli
    python-is-python3   # `python` on the PATH; Ubuntu only ships `python3`
    python3
    python3-pip
    python3-venv
    rbenv
    ripgrep
    ruby-build   # builds Ruby for rbenv; pulls its headers in via Recommends
    unzip
    zsh
  )

  if [ "$IS_WSL" -eq 1 ]; then
    # socat bridges the Bitwarden SSH agent's Windows named pipe into WSL.
    # See docs/bitwarden-ssh-agent.md
    packages+=(socat)
  else
    # Off WSL there is no Bitwarden relay, so keychain holds the ssh-agent.
    # See zsh/functions/keychain
    packages+=(keychain)
  fi

  sudo apt-get install -y "${packages[@]}"
fi

# zshrc exports LANG and LC_ALL, so the locale has to exist before the first
# shell that reads it.
if command -v locale-gen >/dev/null 2>&1; then
  sudo locale-gen en_US.UTF-8
fi
