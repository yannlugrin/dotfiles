#!/bin/bash
#
# System-wide setup: everything that needs sudo. Runs before rcup creates the
# symlinks. Per-user toolchains live in post-up instead.

set -u

if [ -n "${WSL_DISTRO_NAME:-}" ] || grep -qi microsoft /proc/version 2>/dev/null; then
  IS_WSL=1
else
  IS_WSL=0
fi

# Setup GitHub's own apt repository.
if command -v apt-get >/dev/null 2>&1 && command -v curl >/dev/null 2>&1; then
  gh_keyring=/etc/apt/keyrings/githubcli-archive-keyring.gpg
  gh_tmp=$(mktemp)

  if curl -fsSL -o "$gh_tmp" https://cli.github.com/packages/githubcli-archive-keyring.gpg; then
    sudo install -d -m 755 /etc/apt/keyrings
    sudo install -m 644 "$gh_tmp" "$gh_keyring"

    sudo tee /etc/apt/sources.list.d/github-cli.sources >/dev/null <<EOF
Types: deb
URIs: https://cli.github.com/packages
Suites: stable
Components: main
Architectures: $(dpkg --print-architecture)
Signed-By: $gh_keyring
EOF
  else
    echo "Could not fetch the GitHub CLI signing key; skipping its apt repository." >&2
  fi

  rm -f "$gh_tmp"
fi

# Install dependencies on Ubuntu
if command -v apt-get >/dev/null 2>&1; then
  sudo apt-get update
  sudo apt-get upgrade -y

  packages=(
    autoconf     # ruby-build only Suggests it, so ask for it explicitly
    composer
    curl
    gh
    git
    jq
    just
    locales
    php-cli
    python-is-python3   # `python` on the PATH; Ubuntu only ships `python3`
    python3
    python3-pip
    python3-venv
    rbenv
    ripgrep
    ruby-build   # builds Ruby for rbenv; pulls its headers in via Recommends
    unzip
    wget
    zsh
  )

  if [ "$IS_WSL" -eq 1 ]; then
    # socat bridges the Bitwarden SSH agent's Windows named pipe into WSL.
    # See docs/bitwarden-ssh-agent.md
    packages+=(socat)
  else
    # Off WSL there is no Bitwarden relay, so keychain holds the ssh-agent.
    # See zsh/functions/keychain
    packages+=(keychain)
  fi

  sudo apt-get install -y "${packages[@]}"
fi

# zshrc exports LANG and LC_ALL, so the locale has to exist before the first
# shell that reads it.
if command -v locale-gen >/dev/null 2>&1; then
  sudo locale-gen en_US.UTF-8
fi

# Stop Docker Desktop when this distro shuts down, so that closing the terminal
# lets the whole WSL VM go idle. Without this the docker-desktop distro outlives
# Ubuntu and keeps the VM -- and its several gigabytes -- running until the next
# `wsl --shutdown`. See docs/docker-desktop.md
docker_desktop_cli="/mnt/c/Program Files/Docker/Docker/resources/bin/docker.exe"
docker_desktop_sock=/mnt/wsl/docker-desktop/shared-sockets/host-services/backend.sock

if [ "$IS_WSL" -eq 1 ] &&
   [ -x "$docker_desktop_cli" ] &&
   command -v systemctl >/dev/null 2>&1; then

  # The unit does nothing at boot: ExecStart exists only so that a oneshot can
  # stay active, and the whole point is the ExecStop that a stopping distro
  # runs. Ordering it after the interop pieces means it stops *before* them,
  # since systemd stops units in reverse order -- without that, /mnt/c could
  # already be gone by the time we reach for the Windows binary.
  #
  # The stop is spelled out here rather than delegated to the shell function in
  # zsh/functions/docker, because systemd can only exec a file and a function is
  # not one. It is one guarded command: the socket is gone whenever Docker
  # Desktop is already stopped, and `|| true` keeps a failed stop from making
  # the shutdown look broken.
  echo "Installing stop-docker-desktop.service..."

  sudo tee /etc/systemd/system/stop-docker-desktop.service >/dev/null <<EOF
[Unit]
Description=Stop Docker Desktop when this distro shuts down
After=mnt-c.mount systemd-binfmt.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/true
ExecStop=/bin/sh -c '[ -S $docker_desktop_sock ] && "$docker_desktop_cli" desktop stop --timeout 25 || true'
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
EOF

  sudo systemctl daemon-reload
  sudo systemctl enable --now stop-docker-desktop.service
fi
