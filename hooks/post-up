#!/bin/bash
#
# Per-user toolchains, none of which need sudo. Runs after rcup has created the
# symlinks, which the Ruby install below depends on.
#
# Anything that writes to a shell rc file must be neutered here: ~/.zshrc is a
# symlink into this repository, so an installer that "helpfully" appends its
# snippet edits the tracked file. That is how the nvm and bun blocks ended up
# committed in zshrc.

###
### node
###

# The zsh-nvm plugin loads nvm (lazily), but installing it here pins a real
# release instead of relying on the plugin's clone of the long-dead
# creationix/nvm URL. PROFILE=/dev/null keeps the installer out of ~/.zshrc.
if command -v curl >/dev/null 2>&1; then
  NVM_VERSION=$(curl -s https://api.github.com/repos/nvm-sh/nvm/releases/latest | grep '"tag_name"' | cut -d '"' -f4)

  if [ -n "$NVM_VERSION" ]; then
    PROFILE=/dev/null bash -c \
      "curl -o- 'https://raw.githubusercontent.com/nvm-sh/nvm/${NVM_VERSION}/install.sh' | bash"
  else
    echo "Could not resolve the latest nvm release; skipping." >&2
  fi
fi

# Install the latest LTS node and make it the default, so a fresh machine ends
# up with a working node instead of just a working nvm.
export NVM_DIR="${NVM_DIR:-$HOME/.nvm}"
if [ -s "$NVM_DIR/nvm.sh" ]; then
  # shellcheck disable=SC1091
  . "$NVM_DIR/nvm.sh"

  nvm install --lts
  nvm alias default 'lts/*'
fi

###
### ruby
###

# Install rbenv plugins. rbenv-default-gems reads $(rbenv root)/default-gems,
# which rcup links from rbenv/default-gems in this repository.
if command -v rbenv >/dev/null 2>&1; then
  mkdir -p "$(rbenv root)/plugins"
  if [ ! -e "$(rbenv root)/plugins/rbenv-aliases" ]; then
    git clone https://github.com/tpope/rbenv-aliases.git \
        "$(rbenv root)/plugins/rbenv-aliases"
    rbenv alias --auto
  fi

  if [ ! -e "$(rbenv root)/plugins/rbenv-default-gems" ]; then
    git clone https://github.com/rbenv/rbenv-default-gems.git \
        "$(rbenv root)/plugins/rbenv-default-gems"
  fi

  # Install the latest stable Ruby and make it the default.
  #
  # This has to come after the two plugins above and after rcup has linked
  # rbenv/default-gems into $(rbenv root): rbenv-default-gems reads that file
  # while a Ruby is being built, so bundler only lands in the new Ruby if the
  # plugin and the file are already in place. That symlink is the reason this
  # hook, and not pre-up, is where the language runtimes are installed.
  #
  # `rbenv install -l` lists only stable releases. Keeping plain x.y.z drops
  # jruby, truffleruby, mruby and picoruby, leaving the newest MRI.
  ruby_version=$(rbenv install -l 2>/dev/null \
    | grep -E '^[0-9]+\.[0-9]+\.[0-9]+$' \
    | sort -V \
    | tail -1)

  if [ -z "$ruby_version" ]; then
    echo "Could not resolve the latest stable Ruby; skipping." >&2
  else
    if [ ! -d "$(rbenv root)/versions/$ruby_version" ]; then
      echo "Installing Ruby ${ruby_version}, this compiles from source and takes a while..."
      rbenv install "$ruby_version"
    fi

    # rbenv global is the user-wide default; it writes $(rbenv root)/version.
    rbenv global "$ruby_version"
    rbenv rehash

    # Keep the x.y aliases from rbenv-aliases pointing at the new version.
    if [ -e "$(rbenv root)/plugins/rbenv-aliases" ]; then
      rbenv alias --auto
    fi
  fi
fi

###
### Claude Code
###

# This installer only drops a binary in ~/.local/bin and leaves shell rc files
# alone, so it needs no PROFILE guard.
if command -v curl >/dev/null 2>&1; then
  curl -fsSL https://claude.ai/install.sh | bash
fi

###
### Dev Containers CLI
###

# The standalone installer, not `npm install -g @devcontainers/cli`: it drops a
# bundled node under ~/.devcontainers, so the CLI keeps working whatever
# version nvm happens to point at.
#
# It only prints the `export PATH=...` line to add (zshrc already has it) and
# never edits a shell rc file, so it needs no PROFILE guard. Re-running it
# resolves "latest" again and re-points the current symlinks, which is the
# update path; --update only exists to skip the work when nothing is new.
if command -v curl >/dev/null 2>&1; then
  curl -fsSL https://raw.githubusercontent.com/devcontainers/cli/main/scripts/install.sh | sh
fi

###
### Bitwarden CLI
###

# The standalone build from bitwarden.com, not the npm package: it carries its
# own node, so it keeps working whatever nvm's current version is, and nothing
# has to be installed globally into a node that nvm may replace tomorrow.
#
# The SSH agent comes from Bitwarden Desktop, not from this.
# See docs/bitwarden-ssh-agent.md
if command -v curl >/dev/null 2>&1 && command -v unzip >/dev/null 2>&1; then
  case "$(uname -m)" in
    x86_64)          bw_asset="bw-linux" ;;
    aarch64 | arm64) bw_asset="bw-linux-arm64" ;;
    *)               bw_asset="" ;;
  esac

  if [ -z "$bw_asset" ]; then
    echo "No Bitwarden CLI build for $(uname -m); skipping." >&2
  else
    # The download endpoint redirects to the current release asset, so the
    # Location header answers "which version is the latest?" on its own:
    # .../releases/download/cli-v2026.7.0/bw-linux-2026.7.0.zip
    #
    # It only knows about the x86_64 build (?variant=arm64 is a 404), but the
    # release it points at holds every architecture, so the arm64 URL is that
    # same directory with the other asset name.
    bw_url=$(curl -fsI -o /dev/null -w '%{redirect_url}' \
      'https://bitwarden.com/download/?app=cli&platform=linux')

    case "$bw_url" in
      */bw-linux-*.zip)
        bw_version=${bw_url##*/bw-linux-}
        bw_version=${bw_version%.zip}
        bw_url="${bw_url%/*}/${bw_asset}-${bw_version}.zip"
        ;;
      *)
        bw_version=""
        ;;
    esac

    if [ -z "$bw_version" ]; then
      echo "Could not resolve the latest Bitwarden CLI release; skipping." >&2
    elif [ "$("$HOME/.local/bin/bw" --version 2>/dev/null)" != "$bw_version" ]; then
      echo "Installing Bitwarden CLI ${bw_version} (${bw_asset})..."
      bw_tmp=$(mktemp -d)

      if curl -fsSL -o "$bw_tmp/bw.zip" "$bw_url" \
          && unzip -qo "$bw_tmp/bw.zip" bw -d "$bw_tmp"; then
        mkdir -p "$HOME/.local/bin"
        # install(1) puts the binary in place in one step, so a running bw is
        # never left half-written.
        install -m 755 "$bw_tmp/bw" "$HOME/.local/bin/bw"
      else
        echo "Could not install the Bitwarden CLI." >&2
      fi

      rm -rf "$bw_tmp"
    fi
  fi
fi

###
### WSL
###

# Install npiperelay on the Windows side, to bridge the Bitwarden SSH agent
# into WSL. It is the only Windows binary this needs, and is kept under the
# Windows user profile, out of the WSL filesystem and out of $PATH.
# See docs/bitwarden-ssh-agent.md
if [ -n "${WSL_DISTRO_NAME:-}" ] || grep -qi microsoft /proc/version 2>/dev/null; then
  NPIPERELAY_VERSION="v1.11.4"
  NPIPERELAY_SHA256="cea82cf5c9c22a28bef8075750acb7958f766393baebff4597cf21442f71c4b3"
  NPIPERELAY_URL="https://github.com/albertony/npiperelay/releases/download/${NPIPERELAY_VERSION}/npiperelay_windows_amd64.exe"

  # %USERPROFILE% is not exported into WSL, so ask Windows for it. cmd.exe must
  # start from a Windows-reachable directory or it warns about UNC paths.
  windows_home=$(cd /mnt/c && cmd.exe /c "echo %USERPROFILE%" 2>/dev/null | tr -d '\r')

  if [ -z "$windows_home" ]; then
    echo "Could not resolve %USERPROFILE%; skipping npiperelay install." >&2
  else
    npiperelay="$(wslpath -u "$windows_home")/.local/bin/npiperelay.exe"

    # Only download when it is missing or not the pinned build
    if ! echo "$NPIPERELAY_SHA256  $npiperelay" | sha256sum --check --status 2>/dev/null; then
      echo "Installing npiperelay ${NPIPERELAY_VERSION}..."
      mkdir -p "$(dirname "$npiperelay")"
      curl -fsSL "$NPIPERELAY_URL" -o "$npiperelay.tmp"

      if echo "$NPIPERELAY_SHA256  $npiperelay.tmp" | sha256sum --check --status; then
        mv "$npiperelay.tmp" "$npiperelay"
        chmod +x "$npiperelay"
      else
        rm -f "$npiperelay.tmp"
        echo "npiperelay checksum mismatch, not installed." >&2
      fi
    fi

    # Record the path so the shell can find it without spawning cmd.exe on
    # every startup
    if [ -x "$npiperelay" ]; then
      mkdir -p "$HOME/.config/bitwarden-ssh-agent"
      echo "$npiperelay" > "$HOME/.config/bitwarden-ssh-agent/npiperelay-path"
    fi
  fi
fi
