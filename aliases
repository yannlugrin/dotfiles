# Utilities
alias r!='. ~/.zshrc'
alias mkdir='mkdir -p'
alias vi='vim'
alias l='ls'
alias ll='ls -l'
alias la='ls -al'
alias -g G='| grep'
alias -g M='| less'

# Docker
# Completion for these lives in zsh/completions/_dc, which forwards to docker's
# own completion (and says so when Docker is not running).
alias dc='docker compose -p $(project_name)'
alias dce='docker compose -p $(project_name) exec'
alias dcb='docker compose -p $(project_name) build'
alias dcup='docker compose -p $(project_name) up -d'

# Capistrano
alias cap='bundle exec cap'

# Git
alias g='git'
compdef _git g=git
alias gst='git status'
compdef _git gst=git-status
alias gc='git commit'
compdef _git gc=git-commit
alias gc!='git commit --amend --no-edit'
compdef _git gc!=git-commit
alias gap='git add --patch'
compdef _git gap='git add'
alias gaa='git add -AN'
compdef _git gaa='git add'
alias gp='git push'
compdef _git gp='git push'
alias gup='git pull'
compdef _git gup='git pull'
