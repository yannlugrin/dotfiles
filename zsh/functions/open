#!/bin/env zsh
#
# Open files, directories and URLs with the desktop handler, on WSL or on a
# plain Linux desktop.

function open() {
  local -a targets=("$@")
  local target

  (( $# )) || targets=("$PWD")

  for target in "${targets[@]}"; do
    if is_wsl; then
      _open_wsl "$target" || return 1
    elif (( $+commands[xdg-open] )); then
      xdg-open "$target" >/dev/null 2>&1
    else
      print -u2 "open: no handler found (install xdg-utils)"
      return 1
    fi
  done
}

function _open_wsl() {
  local target=$1

  # wslu, when it is installed, handles both URLs and paths.
  if (( $+commands[wslview] )); then
    wslview "$target" >/dev/null 2>&1
    return
  fi

  if [[ "$target" == *://* ]]; then
    # `start` needs an empty title argument, and cmd.exe warns about UNC paths
    # unless it starts from somewhere Windows can reach.
    ( cd /mnt/c && cmd.exe /c start "" "$target" ) >/dev/null 2>&1
    return
  fi

  # explorer.exe exits non-zero even when it succeeds, so its status is useless.
  explorer.exe "$(wslpath -w "$target")" >/dev/null 2>&1
  return 0
}
