#!/bin/env zsh
#
# Open files, directories and URLs with the desktop handler, on WSL or on a
# plain Linux desktop.

function open() {
  local -a targets=("$@")
  local target

  # No implicit current directory: macOS open takes `open .` for that, and so
  # does `code`. Bare `open` is a mistake, and saying so beats guessing.
  if (( ! $# )); then
    print -u2 "Usage: open [target ...]"
    print -u2 "Help:  Open opens files, directories and URLs from a shell."
    return 1
  fi

  for target in "${targets[@]}"; do
    if is_wsl; then
      _open_wsl "$target" || return 1
    elif (( $+commands[xdg-open] )); then
      xdg-open "$target" >/dev/null 2>&1
    else
      print -u2 "open: no handler found (install xdg-utils)"
      return 1
    fi
  done
}

function _open_wsl() {
  local target=$1

  # Tried before the generic handlers below: they hand the URL to Windows, and
  # Windows opens it in whichever browser window was last active, on whatever
  # virtual desktop that window sits on. Only this one keeps the tab in view.
  if [[ "$target" == *://* ]] && _open_url_here "$target"; then
    return
  fi

  # wslu, when it is installed, handles both URLs and paths.
  if (( $+commands[wslview] )); then
    wslview "$target" >/dev/null 2>&1
    return
  fi

  if [[ "$target" == *://* ]]; then
    # `start` needs an empty title argument, and cmd.exe warns about UNC paths
    # unless it starts from somewhere Windows can reach.
    ( cd /mnt/c && cmd.exe /c start "" "$target" ) >/dev/null 2>&1
    return
  fi

  # explorer.exe exits non-zero even when it succeeds, so its status is useless.
  explorer.exe "$(wslpath -w "$target")" >/dev/null 2>&1
  return 0
}

# Open a URL in a browser window on the virtual desktop currently in view. Fails
# when the helper has not been linked yet, when there is no PowerShell to run it
# with, or when the default browser is not one it can drive -- in every case
# leaving the caller to fall back to the plain Windows handler.
function _open_url_here() {
  local helper="${ZSH:-$HOME/.zsh}/lib/open-url.ps1"

  [[ -r "$helper" ]] || return 1
  (( $+commands[powershell.exe] )) || return 1

  # Windows reads the script over \\wsl.localhost, which resolves the symlink
  # rcm leaves in $ZSH on its own, so the path can be passed as it stands.
  powershell.exe -NoProfile -ExecutionPolicy Bypass \
    -File "$(wslpath -w "$helper")" -Url "$1" >/dev/null 2>&1
}
