#!/bin/env zsh

# Docker Compose project name for the current directory: <client>-<project>.
# Derived from the project root, so it stays the same in every subdirectory of
# a project rather than following the last two path components.
function project_name() {
  local root=$(_project_root)
  local name

  if [[ -n "$root" ]]; then
    name="${${root:h}:t}-${root:t}"
  else
    # Outside DEV_BASE_DIR, fall back to the last two path components, or to
    # the last one alone when the path is too shallow to have two.
    if [[ -n "${${PWD:h}:t}" ]]; then
      name="${${PWD:h}:t}-${PWD:t}"
    else
      name="${PWD:t}"
    fi
  fi

  print -r -- "${name:-default}"
}

function _docker_backend_service() {
  _compose_services | grep -E '(dev|backend)' | tr '\n' ' ' | sed 's/ $//'
}

function dev() {
  local target_dir="$DEV_BASE_DIR"

  (( $# >= 1 )) && target_dir="$DEV_BASE_DIR/$1"
  (( $# >= 2 )) && target_dir="$DEV_BASE_DIR/$1/$2"

  [[ "$PWD" == "$target_dir" ]] && return

  cd "$target_dir"
}

function dotfiles() {
  cd ~/.dotfiles
}

function drush() {
  _compose exec "$(_docker_backend_service)" ./vendor/bin/drush "$@"
}

function docker-as-drupal() {
  local service=$(_docker_backend_service)

  # behat and phpunit belong to the test environment, everything else runs
  # against the dev backend.
  if (( $# )) && [[ "$1" == "behat" || "$1" == "phpunit" ]]; then
    service="test"
  fi

  _compose exec "$service" docker-as-drupal "$@"
}

function docker-as-wordpress() {
  _compose exec "$(_docker_backend_service)" docker-as-wordpress "$@"
}

function wp() {
  _compose exec "$(_docker_backend_service)" wp "$@"
}

# Run a tool vendored under tools/<name>, installing it on first use. Both
# php-cs-fixer and psalm are set up this way.
function _php_tool() {
  local name=$1
  shift

  if [[ ! -d "tools/$name" ]]; then
    print -u2 "./tools/$name does not exist"
    return 1
  fi

  ( cd "tools/$name" && composer install ) || return

  "./tools/$name/vendor/bin/$name" "$@"
}

# Run a tool installed by the project itself.
function _vendor_bin() {
  local name=$1
  shift

  if [[ ! -x "./vendor/bin/$name" ]]; then
    print -u2 "./vendor/bin/$name does not exist"
    return 1
  fi

  "./vendor/bin/$name" "$@"
}

function php-cs-fixer() {
  if (( $# == 0 )) || [[ $# -eq 1 && "$1" == "check" ]]; then
    _php_tool php-cs-fixer check --config=.php-cs-fixer.php --using-cache=no
  elif [[ $# -eq 1 && "$1" == "fix" ]]; then
    _php_tool php-cs-fixer fix --config=.php-cs-fixer.php --using-cache=no
  else
    _php_tool php-cs-fixer "$@"
  fi
}

function psalm() {
  if (( $# == 0 )); then
    _php_tool psalm --config=psalm.xml --no-cache
  elif [[ $# -eq 1 && "$1" == "--alter" ]]; then
    _php_tool psalm --config=psalm.xml --no-cache --alter --issues=all
  else
    _php_tool psalm "$@"
  fi
}

function phpcs() {
  _vendor_bin phpcs "$@"
}

function phpcbf() {
  _vendor_bin phpcbf "$@"
}
