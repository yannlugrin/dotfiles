#!/bin/env zsh

# Every docker compose command in these dotfiles goes through here, so the
# project name is derived the same way everywhere.
function _compose() {
  docker compose -p "$(project_name)" "$@"
}

# Service names of the compose project in the current directory. Returns
# non-zero when docker cannot answer.
#
# Docker Desktop's WSL wrapper prints "could not be found in this WSL 2 distro"
# on stdout rather than stderr, so redirecting stderr is not enough: the exit
# status is what has to be trusted.
function _compose_services() {
  local output

  output=$(docker compose config --services 2>/dev/null) || return 1

  print -r -- "$output"
}

# Completion helper: the services of the current project.
function _docker_compose_services() {
  local -a services
  local output

  if ! output=$(_compose_services); then
    _message -r 'docker is not running'
    return 1
  fi

  services=(${(f)output})

  if (( $#services )); then
    _describe 'Docker Compose services' services
  else
    _message -r 'no compose services here'
  fi
}

# Load a database dump into a running development environment.
function dccpdb() {
  local file=$1
  local service=$2

  _compose cp "$file" "$service:/var/backups/db-dump.sql"
}

# Open a shell in a development environment.
function dcshell() {
  local service=$1

  _compose exec "$service" bash
}
