#!/bin/env zsh
#
# Keep an ssh-agent running and the default key loaded in it, shared by every
# shell rather than one agent per terminal.
#
# Under WSL this is not used at all: the keys live in Bitwarden Desktop and
# SSH_AUTH_SOCK points at its relay instead. See zsh/functions/bitwarden-ssh-agent.

if is_wsl; then
  return
fi

if command -v keychain >/dev/null 2>&1; then
  keychain -q "$HOME/.ssh/id_ed25519"
  source "$HOME/.keychain/$HOST-sh"
fi
