#compdef dev

local state
local -a reply projects namespaces
local dir

_arguments '1: :->target'

[[ "$state" == target ]] || return 1

_project_labels
projects=( $reply )

# Namespaces hold no project of their own, but are still somewhere to go.
for dir in "$DEV_BASE_DIR"/*(N/); do
  _is_project_dir "$dir" || namespaces+=( "${dir:t}" )
done

# A fragment matches anywhere in the label, so `dev proj<TAB>` reaches
# namespace/project-name: that is the `l:|=* r:|=*` matcher-list in zshrc.
_alternative \
  'projects:project:compadd -a projects' \
  'namespaces:namespace:compadd -a namespaces'
