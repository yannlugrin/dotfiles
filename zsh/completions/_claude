#compdef claude

# Claude Code ships no completion generator; this is claude-written against
# `claude --help` (2.1.x). Regenerate by re-reading the help output.

_claude_models() {
  local -a models
  models=(
    'fable:latest Fable'
    'opus:latest Opus'
    'sonnet:latest Sonnet'
    'haiku:latest Haiku'
    'claude-fable-5:Fable 5'
    'claude-opus-5:Opus 5'
    'claude-sonnet-5:Sonnet 5'
    'claude-haiku-4-5-20251001:Haiku 4.5'
  )
  _describe -t models 'model' models
}

_claude_agents() {
  local -a agents
  local dir file
  for dir in .claude/agents "$HOME/.claude/agents"; do
    [[ -d $dir ]] || continue
    for file in $dir/*.md(N); do
      agents+=( "${file:t:r}" )
    done
  done
  agents+=( general-purpose Explore Plan )
  _describe -t agents 'agent' agents
}

_claude_effort() {
  local -a levels
  levels=(low medium high xhigh max)
  _describe -t levels 'effort level' levels
}

_claude_permission_mode() {
  local -a modes
  modes=(
    'acceptEdits:auto-accept file edits'
    'auto:let Claude choose'
    'bypassPermissions:skip all checks'
    'manual:ask for everything'
    'dontAsk:never ask'
    'plan:plan mode'
  )
  _describe -t modes 'permission mode' modes
}

_claude_setting_sources() {
  _values -s , 'setting source' user project local
}

_claude_commands() {
  local -a commands
  commands=(
    'agents:Manage background agents'
    'auth:Manage authentication'
    'auto-mode:Inspect or reset auto mode classifier configuration'
    'doctor:Check the health of your Claude Code installation'
    'gateway:Run the enterprise auth/telemetry gateway'
    'import:Import config from another AI coding agent'
    'install:Install Claude Code native build'
    'mcp:Configure and manage MCP servers'
    'plugin:Manage Claude Code plugins'
    'project:Manage Claude Code project state'
    'setup-token:Set up a long-lived authentication token'
    'ultrareview:Run a cloud-hosted multi-agent code review'
    'update:Check for updates and install if available'
  )
  _describe -t commands 'claude command' commands
}

