_claude_mcp() {
  local curcontext="$curcontext" state line ret=1
  _arguments -C \
    '(-h --help)'{-h,--help}'[Display help]' \
    '1: :->command' \
    '*:: :->args' && ret=0

  case $state in
    command)
      local -a cmds
      cmds=(
        'add:Add an MCP server'
        'add-from-claude-desktop:Import servers from Claude Desktop'
        'add-json:Add a server from a JSON string'
        'get:Show details about a server'
        'list:List configured servers'
        'login:Authenticate with a server'
        'logout:Clear a server authentication'
        'remove:Remove a server'
        'reset-project-choices:Reset approved project servers'
        'serve:Run Claude Code as an MCP server'
      )
      _describe -t commands 'mcp command' cmds && ret=0
      ;;
    args)
      case $words[1] in
        add)
          _arguments \
            '(-t --transport)'{-t,--transport}'[Transport type]:transport:(stdio sse http)' \
            '(-s --scope)'{-s,--scope}'[Configuration scope]:scope:(local user project)' \
            '*'{-e,--env}'[Set an environment variable]:KEY=value:' \
            '*'{-H,--header}'[Set a header]:header:' \
            '--client-id[OAuth client id]:client id:' \
            '--client-secret[Prompt for the OAuth client secret]' \
            '--callback-port[Fixed OAuth callback port]:port:' \
            '1:name:' \
            '2:command or url:' \
            '*:args:' && ret=0
          ;;
        add-json)
          _arguments \
            '(-s --scope)'{-s,--scope}'[Configuration scope]:scope:(local user project)' \
            '1:name:' '2:json:' && ret=0
          ;;
        get|remove|login|logout)
          _message 'server name' && ret=0
          ;;
      esac
      ;;
  esac
  return ret
}

_claude_plugin() {
  local curcontext="$curcontext" state line ret=1
  _arguments -C \
    '(-h --help)'{-h,--help}'[Display help]' \
    '1: :->command' \
    '*:: :->args' && ret=0

  case $state in
    command)
      local -a cmds
      cmds=(
        'details:Show a plugin component inventory and token cost'
        'disable:Disable an enabled plugin'
        'enable:Enable a disabled plugin'
        'eval:Run eval cases against a plugin'
        'init:Scaffold a new plugin'
        'new:Scaffold a new plugin'
        'install:Install a plugin from a marketplace'
        'i:Install a plugin from a marketplace'
        'list:List installed plugins'
        'marketplace:Manage plugin marketplaces'
        'prune:Remove unused plugins'
        'autoremove:Remove unused plugins'
        'tag:Tag a plugin'
        'uninstall:Uninstall a plugin'
        'remove:Uninstall a plugin'
        'update:Update installed plugins'
        'validate:Validate a plugin'
      )
      _describe -t commands 'plugin command' cmds && ret=0
      ;;
    args)
      case $words[1] in
        marketplace)
          local -a mcmds
          mcmds=(
            'add:Add a marketplace'
            'list:List marketplaces'
            'remove:Remove a marketplace'
            'rm:Remove a marketplace'
            'update:Update marketplaces'
          )
          _describe -t commands 'marketplace command' mcmds && ret=0
          ;;
        eval|validate|init|new)
          _files && ret=0
          ;;
      esac
      ;;
  esac
  return ret
}

_claude_auth() {
  local -a cmds
  cmds=(
    'login:Sign in to your Anthropic account'
    'logout:Log out from your Anthropic account'
    'status:Show authentication status'
  )
  _describe -t commands 'auth command' cmds
}

_claude_project() {
  local curcontext="$curcontext" state line ret=1
  _arguments -C '1: :->command' '*:: :->args' && ret=0
  case $state in
    command)
      _describe -t commands 'project command' \
        '(purge:Delete all Claude Code state for a project)' && ret=0
      ;;
    args)
      [[ $words[1] == purge ]] && { _files -/ && ret=0 }
      ;;
  esac
  return ret
}

_claude() {
  local curcontext="$curcontext" state line ret=1
  typeset -A opt_args

  _arguments -C -s -S \
    $_claude_global_options \
    '1: :_claude_commands' \
    '*:: :->args' && ret=0

  case $state in
    args)
      case $words[1] in
        mcp)          _claude_mcp && ret=0 ;;
        plugin|plugins) _claude_plugin && ret=0 ;;
        auth)         _claude_auth && ret=0 ;;
        project)      _claude_project && ret=0 ;;
        agents)
          _arguments \
            '*--add-dir[Additional directory to allow]:directory:_files -/' \
            '--agent[Default agent for dispatched sessions]:agent:_claude_agents' \
            '--all[With --json: include completed sessions]' \
            '--allow-dangerously-skip-permissions[Make bypass mode available]' \
            '--cwd[Only sessions started under this path]:path:_files -/' \
            '--dangerously-skip-permissions[Bypass all permission checks]' \
            '--effort[Default effort level]:level:_claude_effort' \
            '--json[Print active sessions as JSON and exit]' \
            '*--mcp-config[MCP configuration]:config:_files' \
            '--model[Default model]:model:_claude_models' \
            '--permission-mode[Default permission mode]:mode:_claude_permission_mode' \
            '*--plugin-dir[Load plugins from a directory]:path:_files -/' \
            '--setting-sources[Setting sources to load]:sources:_claude_setting_sources' \
            '--settings[Settings file or JSON string]:file-or-json:_files' \
            '--strict-mcp-config[Only use MCP servers from --mcp-config]' && ret=0
          ;;
        install)
          _describe -t targets 'target' '(stable:latest stable build latest:most recent build)' && ret=0
          ;;
        ultrareview)
          _message 'PR number, base branch or path' && ret=0
          ;;
        import)
          _describe -t sources 'source' '(cursor:Cursor windsurf:Windsurf copilot:GitHub Copilot)' && ret=0
          ;;
      esac
      ;;
  esac

  return ret
}

_claude "$@"
